# Supabase (Project Settings → API). Без них сайт работает на демо-данных.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Только на сервере! Не публикуйте.
SUPABASE_SERVICE_ROLE_KEY=

# 2ГИС MapGL + Catalog API (https://dev.2gis.com). Без ключа карта скрыта.
NEXT_PUBLIC_2GIS_KEY=

# Оплата: demo | <provider>. В demo заказ можно «оплатить» кнопкой.
PAYMENT_PROVIDER=demo
PAYMENT_WEBHOOK_SECRET=change-me

# Ссылки
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/
NEXT_PUBLIC_APPSTORE_URL=
NEXT_PUBLIC_GOOGLEPLAY_URL=
